  <!-- Page Header -->
  <header class="page-header">
    <h1>Services & Packages</h1>
    <p>Everything you need for an unforgettable night of live music, custom entertainment, and seamless production.</p>
  </header>

  <!-- Services Grid -->
  <section class="services-container">
    
    <!-- Service Card 1 -->
    <div class="service-card">
      <div class="service-icon">🎸</div>
      <h2>Full Wedding Reception Package</h2>
      <p class="service-lead">The complete live music experience to keep your dance floor packed all night long.</p>
      <ul>
        <li>High-energy live performance for up to 4 hours</li>
        <li>Professional high-end PA sound system & stage lighting setup</li>
        <li>Continuous music (DJ/playlist audio during band breaks)</li>
        <li>Full MC services for grand entrances, toasts, and special announcements</li>
        <li>Custom learning of special requests (First Dance, Parent Dances)</li>
      </ul>
    </div>

    <!-- Service Card 2 -->
    <div class="service-card">
      <div class="service-icon">🎷</div>
      <h2>Cocktail Hour & Ceremony Sound</h2>
      <p class="service-lead">Set the perfect mood right from the start with elegant acoustic and small ensemble music.</p>
      <ul>
        <li>Solo or duo acoustic options for ceremony prelude & processional</li>
        <li>Dedicated wireless lapel microphones for your officiant and vows</li>
        <li>Upbeat acoustic trio or jazz combo for cocktail hour</li>
        <li>Independent sound system setup (separate from the main reception stage)</li>
      </ul>
    </div>

    <!-- Service Card 3 -->
    <div class="service-card">
      <div class="service-icon">🎉</div>
      <h2>Corporate Events & Private Parties</h2>
      <p class="service-lead">Bring premium live entertainment to company galas, holiday parties, and private celebrations.</p>
      <ul>
        <li>Tailored setlists to match your event theme and crowd demographic</li>
        <li>Flexible performance schedules and set lengths</li>
        <li>Full production provided (sound technician, wireless mics for speakers)</li>
        <li>Volume control tailored to your venue space</li>
      </ul>
    </div>

  </section>

  <!-- Call to Action Section -->
  <section class="services-cta">
    <h2>Ready to Plan Your Event?</h2>
    <p>Contact us today to check date availability and build a custom package tailored to your venue and budget.</p>
    <a href="index.html#contact" class="cta-button">Get a Custom Quote</a>
  </section>

