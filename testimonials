        <li><a href="index.html#contact">Book Us</a></li>
      </ul>
    </nav>
  </header>

  <!-- Main Content Area -->
  <main>
    <!-- PAGE-SPECIFIC CONTENT GOES HERE -->
  </main>

  <!-- Global Footer -->
  <footer>
    <div class="social-links">
      <a href="https://www.facebook.com/downcityband" target="_blank" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
      <a href="mailto:davidwilson@downcityband.com" aria-label="Email Us"><i class="fas fa-envelope"></i></a>
    </div>
    <p>&copy; DownCity Band. All Rights Reserved. Based in Providence, RI.</p>
  </footer>

  <!-- Mobile Menu Toggle Script -->
  <script>
    const toggleButton = document.querySelector('.menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    toggleButton.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });

    document.querySelectorAll('.nav-links a').forEach(link => {
      link.addEventListener('click', () => {
        navLinks.classList.remove('active');
      });
    });
  </script>
</body>
